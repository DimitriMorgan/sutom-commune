# === PROD ENVIRONMENT ===
APP_ENV=prod
APP_SECRET=<GENERATE-WITH-openssl-rand-hex-32>
APP_DEBUG=0

POSTGRES_DB=sutom_commune
POSTGRES_USER=sutom_commune
POSTGRES_PASSWORD=<STRONG-PASSWORD>

DATABASE_URL=postgresql://sutom_commune:<STRONG-PASSWORD>@db:5432/sutom_commune?serverVersion=17&charset=utf8

CORS_ALLOW_ORIGIN=^https://(www\.)?sutom-commune\.fr$
FRONTEND_URL=https://www.sutom-commune.fr
DEFAULT_URI=https://www.sutom-commune.fr

VITE_API_BASE_URL=/api
VITE_APP_NAME=Sutom-Commune
VITE_SITE_URL=https://www.sutom-commune.fr
