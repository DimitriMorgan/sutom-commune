FROM php:8.4-cli-alpine AS composer

RUN apk add --no-cache git unzip icu-dev libzip-dev postgresql-dev ${PHPIZE_DEPS} \
    && docker-php-ext-install intl pdo_pgsql zip

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

ENV APP_ENV=prod \
    APP_DEBUG=0 \
    APP_RUNTIME_OPTIONS="{\"disable_dotenv\":true}" \
    APP_SECRET=build-time-secret \
    DATABASE_URL="postgresql://sutom_commune:sutom_commune@db:5432/sutom_commune?serverVersion=17&charset=utf8" \
    CORS_ALLOW_ORIGIN="^https://(www\\.)?sutom-commune\\.fr$" \
    FRONTEND_URL="https://www.sutom-commune.fr" \
    DEFAULT_URI="https://www.sutom-commune.fr"

WORKDIR /app

COPY backend/composer.json backend/composer.lock backend/symfony.lock ./
COPY backend ./

RUN composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist \
    && rm -rf var/cache/* var/log/*

FROM php:8.4-fpm-alpine

ENV APP_RUNTIME_OPTIONS="{\"disable_dotenv\":true}"

RUN apk add --no-cache bash icu-libs libpq libzip zip \
    && apk add --no-cache --virtual .build-deps ${PHPIZE_DEPS} icu-dev libzip-dev postgresql-dev \
    && docker-php-ext-install intl opcache pdo_pgsql zip \
    && apk del .build-deps

RUN { \
      echo 'opcache.enable=1'; \
      echo 'opcache.enable_cli=0'; \
      echo 'opcache.memory_consumption=128'; \
      echo 'opcache.interned_strings_buffer=16'; \
      echo 'opcache.max_accelerated_files=20000'; \
      echo 'opcache.validate_timestamps=0'; \
      echo 'opcache.preload_user=www-data'; \
    } > /usr/local/etc/php/conf.d/opcache-prod.ini

WORKDIR /var/www/backend

COPY --chown=www-data:www-data backend ./
COPY --from=composer --chown=www-data:www-data /app/vendor ./vendor

RUN mkdir -p var/cache var/log \
    && chown -R www-data:www-data var

CMD ["php-fpm"]
